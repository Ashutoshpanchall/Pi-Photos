<?xml version="1.0" encoding="utf-8"?>
<com.example.piphotos.media.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1.5dp">

    <!-- Square Photo View (Sharp straight edges) -->
    <ImageView
        android:id="@+id/ivMediaPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Video Duration Overlay -->
    <LinearLayout
        android:id="@+id/layoutVideoBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_video_duration"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_play_badge"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvVideoDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:42"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Favorite Heart Overlay -->
    <ImageView
        android:id="@+id/ivFavoriteBadge"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="6dp"
        android:src="@drawable/ic_heart"
        android:visibility="gone"
        app:tint="@color/status_amber" />

    <!-- Selection Checkmark Circle Overlay -->
    <FrameLayout
        android:id="@+id/layoutCheckOverlay"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_selection_circle_unselected"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivCheckIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="@color/white" />
    </FrameLayout>

</com.example.piphotos.media.SquareFrameLayout>
