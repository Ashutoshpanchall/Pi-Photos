<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Square-edged image view, uncropped, aspect ratio preserved, black letterboxing -->
    <com.example.piphotos.ZoomableImageView
        android:id="@+id/zoomImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Video PlayerView: fit mode, square edges, no rounded corners -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:use_controller="false"
        app:resize_mode="fit" />

    <!-- Video Center Controls Overlay: Visible when item is a video -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/videoOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Top Right Duration Pill -->
        <LinearLayout
            android:id="@+id/layoutDurationBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_video_duration"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/ic_play_badge"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvDurationBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Center Controls Row: Rewind 10s, Center Play/Pause, Forward 10s -->
        <LinearLayout
            android:id="@+id/layoutCenterControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Rewind 10 Seconds -->
            <FrameLayout
                android:id="@+id/btnRewind10"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_video_circle_play"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_replay_10"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- Center Circular Play / Pause Button -->
            <FrameLayout
                android:id="@+id/btnCenterPlayPause"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_video_circle_play"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivCenterPlayPause"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_arrow"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- Forward 10 Seconds -->
            <FrameLayout
                android:id="@+id/btnForward10"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/bg_video_circle_play"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_forward_10"
                    app:tint="@color/white" />
            </FrameLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
