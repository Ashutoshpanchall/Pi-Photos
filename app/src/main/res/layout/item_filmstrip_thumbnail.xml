<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/filmstripItemRoot"
    android:layout_width="54dp"
    android:layout_height="70dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="true">

    <!-- Floating Window Card (10dp corner radius, original brightness) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardThumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- Video Duration / Play Badge in bottom corner -->
        <LinearLayout
            android:id="@+id/layoutVideoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="3dp"
            android:background="@drawable/bg_video_duration"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_play_badge"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvVideoDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/white"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subtle hairline perimeter outline for crisp floating window look -->
        <View
            android:id="@+id/viewWindowOutline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_floating_card_outline" />
    </androidx.cardview.widget.CardView>

    <!-- Active Selection Border (2.5dp crisp solid white border, 10dp radius) -->
    <View
        android:id="@+id/viewActiveBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_filmstrip_thumb_active"
        android:visibility="gone" />

</FrameLayout>
