<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Apple-style dark frosted glass background (88% black #E0121212) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E0121212" />
        </shape>
    </item>
    <!-- Crisp hairline bottom border (0.5dp, 16% white alpha) -->
    <item android:bottom="0dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="0.5dp"
                android:color="#29FFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
