<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Dark). -->
    <style name="Base.Theme.PiPhotos" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorBackground">@color/bg_page</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="bottomNavigationStyle">@style/CustomBottomNavStyle</item>
    </style>

    <style name="Theme.PiPhotos.PhotoViewer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:windowAnimationStyle">@style/PhotoViewerAnimation</item>
    </style>

    <style name="PhotoViewerAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/viewer_enter_fade</item>
        <item name="android:activityOpenExitAnimation">@anim/viewer_exit_fade</item>
        <item name="android:activityCloseEnterAnimation">@anim/viewer_enter_fade</item>
        <item name="android:activityCloseExitAnimation">@anim/viewer_exit_fade</item>
    </style>
</resources>
